# ============================================================
# Supabase - configuração pública necessária no browser/SSR
# ============================================================
# Estes valores são publicáveis. A segurança dos dados continua dependente
# de Auth, RLS, policies de Storage e da API controlada em `aplicacao`.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_chave_publicavel

# ============================================================
# Segredos somente servidor
# ============================================================
# Não adicione NEXT_PUBLIC nestas variáveis.
# SUPABASE_SECRET_KEY só será utilizada se uma futura função administrativa
# realmente exigir privilégio elevado. O fluxo normal do usuário não precisa dela.
SUPABASE_SECRET_KEY=configurar_apenas_no_servidor

# A chave OpenAI fornecida em conversa não deve ser reutilizada sem rotação.
OPENAI_API_KEY=configurar_apenas_no_servidor

# ============================================================
# Configuração centralizada dos modelos de IA
# ============================================================
MODELO_IA_EXTRACAO=
MODELO_IA_ANALISE=
MODELO_IA_CEREBRO=
MODELO_IA_REDACAO=
MODELO_IA_AUDITORIA=
MODELO_IA_EMBEDDING=
